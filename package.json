{
  "name": "pi-fff-non-ascii-guard",
  "version": "0.1.1",
  "description": "Pi extension that detects and renames non-ASCII filenames before fff-core can panic on UTF-8 byte boundaries.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "fff-core",
    "filename",
    "utf-8"
  ],
  "license": "MIT",
  "author": "Keisu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-fff-non-ascii-guard.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-fff-non-ascii-guard/issues"
  },
  "homepage": "https://github.com/eiei114/pi-fff-non-ascii-guard#readme",
  "files": [
    "README.md",
    "LICENSE",
    "extensions"
  ],
  "scripts": {
    "check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
